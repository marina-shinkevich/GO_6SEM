{
    "swagger": "2.0",
    "info": {
        "description": "Полное REST API для управления списком знаменитостей с использованием локального хранилища.",
        "title": "Celebrities API",
        "contact": {},
        "version": "1.0"
    },
    "host": "localhost:3001",
    "basePath": "/",
    "paths": {
        "/celebrities": {
            "get": {
                "description": "Возвращает полный список знаменитостей",
                "produces": [
                    "application/json"
                ],
                "summary": "Получить всех знаменитостей",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/main.Celebrity"
                            }
                        }
                    }
                }
            },
            "post": {
                "description": "Принимает JSON без ID, генерирует ID автоматически и сохраняет в массив",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "summary": "Создать новую знаменитость",
                "parameters": [
                    {
                        "description": "Данные знаменитости",
                        "name": "celebrity",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/main.Celebrity"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/main.Celebrity"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/celebrities/{id}": {
            "get": {
                "description": "Возвращает одну знаменитость по её числовому идентификатору",
                "produces": [
                    "application/json"
                ],
                "summary": "Получить знаменитость по ID",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "ID Знаменитости",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/main.Celebrity"
                        }
                    },
                    "404": {
                        "description": "Celebrity not found",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            },
            "put": {
                "description": "Находит знаменитость по ID и перезаписывает её данные",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "summary": "Обновить существующую знаменитость",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "ID Знаменитости",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "Новые данные знаменитости",
                        "name": "celebrity",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/main.Celebrity"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/main.Celebrity"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "404": {
                        "description": "Celebrity not found",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            },
            "delete": {
                "description": "Удаляет знаменитость из локального массива по ID",
                "produces": [
                    "application/json"
                ],
                "summary": "Удалить знаменитость",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "ID Знаменитости",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Celebrity deleted successfully",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "404": {
                        "description": "Celebrity not found",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "main.Celebrity": {
            "description": "Модель знаменитости.",
            "type": "object",
            "properties": {
                "fullname": {
                    "description": "@Description Полное Имя знаменитости (обязательное поле)",
                    "type": "string"
                },
                "id": {
                    "description": "@Description Уникальный идентификатор знаменитости",
                    "type": "integer"
                }
            }
        }
    }
}